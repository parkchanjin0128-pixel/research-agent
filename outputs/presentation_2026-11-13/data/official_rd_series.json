{
  "metadata": {
    "title": "China official national R&D expenditure series, annual reporting years 2013-2020",
    "coverage": "Mainland China national aggregate; 2018-2020 bulletins explicitly exclude Hong Kong SAR, Macao SAR and Taiwan",
    "price_basis": "Nominal RMB at each reporting year's prices (current prices); not inflation adjusted, not present discounted value",
    "original_currency_unit": "亿元人民币 = 100 million RMB; multiply by 0.1 for RMB billion, by 100000000 for RMB",
    "time_basis": "Calendar reporting year; release dates usually in following year. These are observed annual expenditures, not policy implementation dates.",
    "vintage_policy": "Expenditure levels and reported shares copied from each year's original joint bulletin. GDP intensities retained as originally released; documented subsequent revisions are separate below. This is not a harmonized latest-vintage GDP-intensity series.",
    "sector_basis": "Sector of performance: enterprises, government-affiliated research institutes, higher education. Government institute expenditure is NOT government funding of all R&D; enterprise expenditure includes state-owned and private enterprises and is NOT private capital.",
    "inference_limit": "Descriptive aggregate diagnostic only. No causal identification of the effect of 2018 US export-control signals, anticipation, private-firm response, or capital allocation.",
    "authoring_date": "2026-11-12"
  },
