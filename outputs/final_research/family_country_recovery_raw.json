up":"H01L21/","origin":"APP","pairs":1,"family_known_pairs":1,"changed_document_pairs":1,"source_families_known":1,"b_family_known_only":0.0,"b_family_lower":0.0,"b_family_upper":0.0},{"main_group":"H01L23/","origin":"ALL","pairs":467,"family_known_pairs":289,"changed_document_pairs":139,"source_families_known":90,"b_family_known_only":0.19019607843137254,"b_family_lower":0.1177016416845111,"b_family_upper":0.5032170898337922},{"main_group":"H01L27/","origin":"ALL","pairs":439,"family_known_pairs":312,"changed_document_pairs":193,"source_families_known":98,"b_family_known_only":0.0787698412698413,"b_family_lower":0.05598221065191454,"b_family_upper":0.35837401019633364},{"main_group":"H01L29/","origin":"ALL","pairs":422,"family_known_pairs":301,"changed_document_pairs":191,"source_families_known":97,"b_family_known_only":0.14864089398973118,"b_family_lower":0.10523122217435013,"b_family_upper":0.3983986787304322},{"main_group":"H01L29/","origin":"APP","pairs":1,"family_known_pairs":1,"changed_document_pairs":1,"source_families_known":1,"b_family_known_only":0.0,"b_family_lower":0.0,"b_family_upper":0.0},{"main_group":"H01L31/","origin":"ALL","pairs":494,"family_known_pairs":254,"changed_document_pairs":139,"source_families_known":89,"b_family_known_only":0.3355643044619424,"b_family_lower":0.1718623481781377,"b_family_upper":0.6617408906882594},{"main_group":"H01L31/","origin":"APP","pairs":20,"family_known_pairs":20,"changed_document_pairs":12,"source_families_known":5,"b_family_known_only":0.3,"b_family_lower":0.3,"b_family_upper":0.3},{"main_group":"H01L33/","origin":"ALL","pairs":491,"family_known_pairs":277,"changed_document_pairs":158,"source_families_known":97,"b_family_known_only":0.15289238439057937,"b_family_lower":0.08584763844437979,"b_family_upper":0.5286029483076327},{"main_group":"H01L33/","origin":"APP","pairs":3,"family_known_pairs":1,"changed_document_pairs":1,"source_families_known":1,"b_family_known_only":0.0,"b_family_lower":0.0,"b_family_upper":0.6666666666666667},{"main_group":"H01L51/","origin":"ALL","pairs":452,"family_known_pairs":306,"changed_document_pairs":182,"source_families_known":98,"b_family_known_only":0.0973078120136944,"b_family_lower":0.06587652760219133,"b_family_upper":0.39589127686472825},{"main_group":"H01L51/","origin":"APP","pairs":6,"family_known_pairs":5,"changed_document_pairs":1,"source_families_known":2,"b_family_known_only":0.0,"b_family_lower":0.0,"b_family_upper":0.16666666666666669}],"summary":{"ALL":{"groups_with_pairs":24,"pairs":10747,"family_known_pairs":6561,"changed_document_pairs":3221,"median_interval_width":0.41413537900626696,"point_range":[0.0787698412698413,0.5520715630885127],"marginal_intersection":[0.42258297258297256,0.35837401019633364]},"APP":{"groups_with_pairs":21,"pairs":765,"family_known_pairs":745,"changed_document_pairs":291,"median_interval_width":0.0,"point_range":[0.0,1.0],"marginal_intersection":[1.0,0.0]}},"tail_sql":"\n), target_families AS (SELECT DISTINCT target_family FROM pair_representative),\nfamily_documents AS (\n SELECT f.target_family,pub.pat_publn_id,pub.publn_date,\n COUNT(DISTINCT CASE WHEN pa.applt_seq_nr IS NULL THEN NULL WHEN pa.person_id>0 THEN CONCAT('P',CAST(pa.person_id AS STRING)) ELSE CONCAT('S',CAST(pa.applt_seq_nr AS STRING)) END) listed,\n COUNT(DISTINCT IF(REGEXP_CONTAINS(TRIM(p.person_ctry_code),r'^[A-Z]{2}$') AND TRIM(p.person_ctry_code) NOT IN ('XX','ZZ','WO','EP','AP','EA','OA','GC','IB'),pa.person_id,NULL)) known,\n COUNT(DISTINCT IF(TRIM(p.person_ctry_code)='US',pa.person_id,NULL)) us\n FROM target_families f JOIN @tls201_appln@ a ON a.docdb_family_id=f.target_family\n JOIN @tls211_pat_publn@ pub USING(appln_id)\n LEFT JOIN @tls227_pers_publn@ pa ON pa.pat_publn_id=pub.pat_publn_id AND pa.applt_seq_nr>0\n LEFT JOIN @tls206_person@ p ON p.person_id=pa.person_id\n WHERE pub.publn_date BETWEEN DATE '1900-01-01' AND DATE '2017-12-31'\n GROUP BY 1,2,3\n), representative_family_document AS (\n SELECT * FROM family_documents WHERE known>0\n QUALIFY ROW_NUMBER() OVER(PARTITION BY target_family ORDER BY publn_date,pat_publn_id)=1\n), rec AS (\n SELECT r.main_group,r.family,r.origin,r.target_family,r.cited_pat_publn_id original_document,\n f.pat_publn_id family_document,IFNULL(f.listed,0) listed,IFNULL(f.known,0) known,IFNULL(f.us,0) us\n FROM pair_representative r LEFT JOIN representative_family_document f USING(target_family)\n)\nSELECT main_group,origin,COUNT(*) pairs,COUNTIF(known>0) family_known_pairs,\n COUNTIF(family_document IS NOT NULL AND family_document!=original_document) changed_document_pairs,\n COUNT(DISTINCT IF(known>0,family,NULL)) source_families_known,\n AVG(IF(known>0,SAFE_DIVIDE(us,known),NULL)) b_family_known_only,\n AVG(IF(listed>0,SAFE_DIVIDE(us,listed),0.0)) b_family_lower,\n AVG(IF(listed>0,SAFE_DIVIDE(us+listed-known,listed),1.0)) b_family_upper\nFROM rec GROUP BY 1,2 ORDER BY 1,2\n","selected_groups":["C12N1/","C12N15/","C12N5/","C12N9/","G01S5/","G06F1/","G06F11/","G06F12/","G06F13/","G06F15/","G06F17/","G06F19/","G06F21/","G06F3/","G06F40/","G06F9/","G06N20/","H01L21/","H01L23/","H01L27/","H01L29/","H01L31/","H01L33/","H01L51/"],"base_script_sha256":"3d7b8c7d243bae214878378d07e4050c344f334cc3b90ea7fbc15d56fa891cd9","cutoff":"2017-12-31","executed_utc":"2026-11-12T14:26:42.039837+00:00","post_outcomes_queried":false}