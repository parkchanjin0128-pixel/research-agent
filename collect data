#!/usr/bin/env python3
"""무료 공개 자료 수집기 (가격 원자료만 받는다. 가공·해석은 하지 않는다).

사용법
  python collect_data.py --test     # 출처마다 1건씩만 받아 연결 확인 (1분 이내)
  python collect_data.py            # 전체 수집 (약 20~40분, 중단 후 다시 실행하면 이어받음)
  python collect_data.py --only yahoo,dukascopy,polymarket,kalshi   # 일부만

결과는 스크립트 옆 data_raw/ 에 원본 그대로 저장된다.
  data_raw/yahoo/<심볼>_<간격>.json.gz        Yahoo chart API 응답 원문
  data_raw/dukascopy/<상품>_<연도>.zip        일별 1분봉 원본(.bi5), 압축만 다시 묶음
  data_raw/polymarket/events.jsonl.gz, prices/<token>.json
  data_raw/kalshi/events.jsonl.gz, candles/<ticker>.json
  data_raw/collect_log.jsonl                  요청별 성공·실패 기록
  data_raw/MANIFEST.json                      수집 시각, 파일 목록, sha256

의존성: Python 3.8+ 와 requests 뿐이다 (Anaconda 기본 포함).
"""
import argparse
import datetime as dt
import gzip
import hashlib
import io
import json
import os
import sys
import threading
import time
import zipfile
from concurrent.futures import ThreadPoolExecutor

try:
    import requests
except ImportError:
    sys.exit("requests 가 없습니다:  pip install requests")

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data_raw")
UA = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                    "(KHTML, like Gecko) Chrome/126.0 Safari/537.36"}
NOW = dt.datetime.now(dt.timezone.utc)
START = dt.datetime(2024, 11, 1, tzinfo=dt.timezone.utc)   # 2024년 대선 직전부터
LOCK = threading.Lock()
SESSION = requests.Session()
SESSION.headers.update(UA)


def log(source, key, ok, note=""):
    rec = {"t": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
           "source": source, "key": key, "ok": bool(ok), "note": str(note)[:300]}
    with LOCK:
        os.makedirs(ROOT, exist_ok=True)
        with open(os.path.join(ROOT, "collect_log.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")


def get(url, params=None, tries=4, timeout=40, ok_404=False):
    """(status, content) 를 돌려준다. 네트워크 오류면 (0, b'')."""
    last = ""
    for i in range(tries):
        try:
            r = SESSION.get(url, params=params, timeout=timeout)
            if r.status_code == 200:
                return 200, r.content
            if r.status_code == 404 and ok_404:
                return 404, b""
            last = "HTTP %s" % r.status_code
            if r.status_code in (400, 401, 403, 404, 422):
                return r.status_code, r.content
        except Exception as e:  # noqa
            last = repr(e)
        time.sleep(1.5 * (i + 1))
    return 0, last.encode()


def exists(path):
    return os.path.exists(path) and os.path.getsize(path) > 0


